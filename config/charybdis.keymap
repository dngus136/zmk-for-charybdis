#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    macros {
        To0_macro: To0_macro {
            compatible = "zmk,behavior-macro";
            label = "To0_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFR &to 0>;
        };

        To2_macro: To2_macro {
            compatible = "zmk,behavior-macro";
            label = "To2_macro";
            #binding-cells = <0>;
            bindings =
                <&to 2>,
                <&macro_wait_time 30>,
                <&rgb_ug RGB_COLOR_HSB(250,100,50)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        Next {
            bindings = <&mkp MB4>;
            key-positions = <37 38>;
            layers = <0 1>;
        };

        Previous {
            bindings = <&mkp MB5>;
            key-positions = <39 40>;
            layers = <0 1>;
        };

        Parenthesis_L {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <7 8>;
            layers = <0 2>;
        };

        Parenthesis_R {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <9 10>;
            layers = <0 1>;
        };

        Page_down {
            bindings = <&kp PAGE_DOWN>;
            key-positions = <43 44>;
            layers = <0 1>;
        };

        Page_up {
            bindings = <&kp PAGE_UP>;
            key-positions = <44 45>;
            layers = <0 1>;
        };

        Hanja {
            bindings = <&kp LANG_HANJA>;
            key-positions = <24 36>;
            layers = <0 1>;
        };

        Up {
            bindings = <&kp UP_ARROW>;
            key-positions = <20 32>;
        };

        Down {
            bindings = <&kp DOWN_ARROW>;
            key-positions = <32 44>;
        };

        Right {
            bindings = <&kp RIGHT_ARROW>;
            key-positions = <32 33>;
        };

        Left {
            bindings = <&kp LEFT_ARROW>;
            key-positions = <32 31>;
        };
    };

    behaviors {
        lgui_hanguel: lgui_hanguel {
            compatible = "zmk,behavior-tap-dance";
            label = "LGUI_HANGUEL";
            #binding-cells = <0>;
            bindings = <&kp LGUI>, <&kp LANG_HANGEUL>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&mt SQT ESC       &kp N1  &kp N2   &kp N3     &kp N4     &kp N5           &kp N6         &kp N7      &kp N8     &kp N9   &kp N0    &kp BACKSPACE
&kp TAB           &kp Q   &kp W    &kp E      &kp R      &kp T            &kp Y          &kp U       &kp I      &kp O    &kp P     &kp BSLH
&kp LEFT_SHIFT    &kp A   &lt 4 S  &kp D      &kp F      &kp G            &kp H          &kp J       &kp K      &kp L    &kp SEMI  &kp SQT
&kp LEFT_CONTROL  &kp Z   &kp X    &kp C      &kp V      &kp B            &kp N          &kp M       &kp COMMA  &kp DOT  &kp FSLH  &kp RIGHT_SHIFT
                                   &kp SPACE  &to 1      &lgui_hanguel    &kp RIGHT_ALT  &kp DELETE
                                              &mkp LCLK  &mkp RCLK        &kp ENTER
            >;
        };

        F_layers {
            bindings = <
&kp F1          &kp F2         &kp F3        &kp F4        &kp F5        &kp F6                       &kp F7             &kp F8    &kp F9            &kp F10            &kp F11          &kp F12
&kp KP_NUMLOCK  &kp BACKSPACE  &kp N7        &kp N8        &kp N9        &mt MINUS PLUS               &none              &kp HOME  &kp UP            &kp END            &kp PRINTSCREEN  &kp SCROLLLOCK
&kp K_CALC      &kp DELETE     &kp NUMBER_4  &kp N5        &kp NUMBER_6  &mt KP_DIVIDE KP_MULTIPLY    &none              &kp LEFT  &kp DOWN          &kp RIGHT          &none            &kp MINUS
&kp CAPSLOCK    &kp CLEAR      &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &none                        &none              &none     &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &none            &trans
                                             &trans        &to 0         &lgui_hanguel                &kp K_SCROLL_UP    &mkp MB4
                                                           &mkp LCLK     &mkp RCLK                    &kp K_SCROLL_DOWN
            >;
        };

        BT_layers {
            bindings = <
&trans  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_CLR_ALL  &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &bt BT_CLR    &trans        &trans          &bt BT_NXT  &trans  &trans  &trans  &trans  &trans
                                      &trans        &trans        &trans          &trans      &trans
                                                    &trans        &trans          &trans
            >;
        };

        scroll-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        snipe-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &mkp LCLK  &mkp RCLK  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &mkp LCLK  &mkp RCLK
                                &trans  &trans    &trans
            >;
        };
    };
};
